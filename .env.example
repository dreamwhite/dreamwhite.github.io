# Dream Platform shared Traefik integration.
# The default matches the local Pawxy/dnsmasq zone used by dream-platform.
DREAMWHITE_DOMAIN=dreamwhite.dream.test
DREAM_EDGE_NETWORK=dream_edge

# Optional Compose resource names.
DREAMWHITE_APP_NETWORK=dreamwhite_default
DREAMWHITE_NODE_MODULES_VOLUME=dreamwhite_site_dev_node_modules
DREAMWHITE_NEXT_VOLUME=dreamwhite_site_dev_next
